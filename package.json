{
  "name": "@opencollective/taxes",
  "version": "5.5.0",
  "description": "Helpers to calculate taxes on Open Collective",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run turbo -- run test:task --",
    "test:watch": "npm run turbo -- run test:watch:task --",
    "test:coverage": "npm run turbo -- run test:coverage:task --",
    "build": "npm run turbo -- run build:compile",
    "lint": "npm run turbo -- run lint:task --",
    "lint:check": "npm run turbo -- run lint:check:task --",
    "lint:fix": "npm run turbo -- run lint:fix:task --",
    "prepublish": "npm run build",
    "prettier": "npm run turbo -- run prettier:task --",
    "prettier:check": "npm run turbo -- run prettier:check:task --",
    "prettier:write": "npm run turbo -- run prettier:write:task --",
    "type:check": "npm run turbo -- run type:check:task --",
    "depcheck": "npm run turbo -- run depcheck:task --",
    "format:check": "npm run turbo -- run format:check:task --",
    "format": "npm run turbo -- run format:task --",
    "turbo": "turbo --skip-infer --single-package --root-turbo-json=turbo.standalone.json",
    "build:compile": "tsc -d",
    "build:clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "test:task": "jest",
    "test:watch:task": "jest --watch",
    "test:coverage:task": "jest --coverage",
    "lint:task": "eslint .",
    "lint:check:task": "npm run lint:task -- --quiet",
    "lint:fix:task": "npm run lint:task -- --fix",
    "prettier:task": "prettier \"**/*.@(js|ts|json|md)\" --ignore-path .gitignore",
    "prettier:check:task": "npm run prettier:task -- --check",
    "prettier:write:task": "npm run prettier:task -- --write",
    "type:check:task": "tsc --noEmit",
    "depcheck:task": "npx depcheck .",
    "format:check:task": "npm run prettier:check:task",
    "format:task": "npm run prettier:write:task"
  },
  "engines": {
    "node": ">18.0.0",
    "npm": ">9.0.0"
  },
  "keywords": [
    "tax",
    "vat",
    "open-collective"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/opencollective/opencollective-taxes.git"
  },
  "author": "Benjamin Piouffle",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "eslint": "^9.39.4",
    "eslint-config-opencollective": "^6.2.0",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "jest-util": "^30.4.1",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "turbo": "2.11.7"
  },
  "dependencies": {
    "jsvat-next": "3.0.4",
    "lodash": "^4.18.1",
    "sales-tax": "2.23.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "transform": {
      "\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "testRegex": "/test/.*\\.(ts|tsx|js)$",
    "modulePathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/.history/"
    ]
  },
  "depcheck": {
    "ignores": [
      "jest-junit",
      "@types/jest",
      "typescript-eslint",
      "turbo"
    ]
  },
  "packageManager": "npm@11.19.0"
}
